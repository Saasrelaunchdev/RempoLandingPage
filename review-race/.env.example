# The Review Race's settings. In Vercel: Project > Settings > Environment Variables (tick Production and Preview).
# For local work, copy this file to .env.local and run `npm run dev` (tools/dev.mjs reads .env.local).
# Never put real values in this file: it is committed.

# --- Required: the race cannot run without these ------------------------------------------------------------------
SERPAPI_API_KEY=                 # serpapi.com > Dashboard > Your Private API Key
ANTHROPIC_API_KEY=               # console.anthropic.com > API Keys (the landing page's /admin already has one)
SUPABASE_URL=                    # Supabase > Project Settings > Data API > Project URL
SUPABASE_SECRET_KEY=             # Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). Server only.

# --- Optional: the search box -------------------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=         # suggestions as the owner types (Google Cloud > Credentials, restricted to "Places API
#                                # (New)"; needs billing on). Without it, the owner types name and town and presses Find,
#                                # which spends 1 SerpApi search
# RACE_SEARCH=maps               # use the SerpApi search even when the Google key is set

# --- Email: the owner's results and follow-ups, and the alert to your team ------------------------------------------
RESEND_API_KEY=                  # resend.com > API Keys (sending access)
RACE_EMAIL_FROM=                 # what owners see, on a verified Resend domain: Rempo <reports@your-domain>
RACE_REPLY_TO=                   # optional: where owners' replies go, e.g. you@your-domain
LEAD_NOTIFY_FROM=                # the team alert's sender, e.g. Rempo Leads <leads@your-domain>
LEAD_NOTIFY_TO=                  # who gets the team alert, comma separated
SLACK_WEBHOOK_URL=               # optional: a Slack incoming webhook for the team alert
RACE_POSTAL_ADDRESS=             # the postal address commercial email must carry (US CAN-SPAM)

# --- GoHighLevel: the CRM and the call calendar --------------------------------------------------------------------
GHL_TOKEN=                       # the landing page's own variable; Settings > Private Integrations > Create: scopes contacts.write, contacts.readonly,
                                 # calendars.readonly, calendars/events.write
GHL_LOCATION_ID=                 # Settings > Business Profile > Location ID (the sub-account)
GHL_CALENDAR_ID=                 # Calendars > the 15-minute call calendar > its ID
GHL_BOOKING_URL=                 # optional: the calendar's public booking link, shown if the in-page calendar fails

# --- Protection and the daily job ----------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=              # Cloudflare > Turnstile > Add widget (this project's domain), "Invisible" or "Managed"
TURNSTILE_SECRET_KEY=            # the same widget's secret key
CRON_SECRET=                     # any long random text; Vercel sends it to /api/race-cron every day
RACE_LINK_SECRET=                # any long random text; signs the unsubscribe links
# RACE_PUBLIC_URL=               # the address in email links, no trailing slash. Not needed on a Vercel preview (the
#                                # branch's own URL is used); set it once the tool has its own domain

# --- Optional ------------------------------------------------------------------------------------------------------
# LEAD_HASH_SALT=                # the landing page's salt for hashing IP addresses, if you want the same hashes
# RACE_SITE_URL=https://rempo.io # "See how Rempo runs it" and the default legal links
# RACE_PRIVACY_URL=              # default: RACE_SITE_URL/legal/privacy
# RACE_TERMS_URL=                # default: RACE_SITE_URL/legal/terms
# RACE_CASE_STUDY_URL=           # turns on the day-9 email, e.g. https://rempo.io/case-studies/ranchero-plumbing
# RACE_CLAUDE_EFFORT=medium      # low, medium, high, xhigh or max
# RACE_DAILY_CAP=40              # races started per day, all visitors (each costs about 11 SerpApi searches)
# RACE_IP_DAILY=5                # races per network per day
# RACE_CACHE_DAYS=7              # a business raced within this many days is shown again with no new searches
# RACE_NURTURE=on                # off: no follow-up emails
# RACE_UPDATES=on                # off: no race-update emails (each update spends 1 or 2 SerpApi searches)
# GHL_STOP_TAGS=customer,client,race-booked,race-unsubscribed   # contacts with any of these get no follow-ups
# GHL_API_VERSION=2021-07-28
# GHL_CALENDAR_API_VERSION=2021-04-15
# RACE_FAKE=1                    # demo mode: sample data, nothing sent anywhere (no keys needed)
# RACE_STORE=memory              # local work only: keep races in memory instead of Supabase
