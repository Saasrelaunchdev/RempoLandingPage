{
  "functions": {
    "api/lead.mjs": { "maxDuration": 30 },
    "api/race.mjs": { "maxDuration": 120 },
    "api/race-cron.mjs": { "maxDuration": 300 },
    "api/admin.mjs": { "maxDuration": 60 },
    "api/admin-ingest.mjs": { "maxDuration": 300, "includeFiles": "node_modules/ffmpeg-static/ffmpeg" },
    "api/proof.mjs": { "maxDuration": 15 },
    "api/case-study.mjs": { "maxDuration": 15 },
    "api/checkout.mjs": { "maxDuration": 30 },
    "api/stripe-webhook.mjs": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/race-cron", "schedule": "17 15 * * *" }
  ],
  "redirects": [
    { "source": "/meta/:path*", "destination": "/", "permanent": false },
    { "source": "/privacy", "destination": "/legal/privacy", "permanent": false },
    { "source": "/privacy-policy", "destination": "/legal/privacy", "permanent": false },
    { "source": "/terms", "destination": "/legal/terms", "permanent": false },
    { "source": "/terms-of-service", "destination": "/legal/terms", "permanent": false },
    { "source": "/cookies", "destination": "/legal/cookies", "permanent": false },
    { "source": "/sms", "destination": "/legal/sms", "permanent": false },
    { "source": "/sms-terms", "destination": "/legal/sms", "permanent": false },
    { "source": "/do-not-sell", "destination": "/legal/privacy-choices", "permanent": false },
    { "source": "/privacy-choices", "destination": "/legal/privacy-choices", "permanent": false },
    { "source": "/accessibility", "destination": "/legal/accessibility", "permanent": false }
  ],
  "rewrites": [
    { "source": "/customers", "destination": "/customers/index.html" },
    { "source": "/customers/:page", "destination": "/customers/:page/index.html" },
    { "source": "/legal", "destination": "/legal/index.html" },
    { "source": "/legal/:page", "destination": "/legal/:page/index.html" },
    { "source": "/case-studies/:slug", "destination": "/api/case-study?slug=:slug" },
    { "source": "/case-studies/:slug/", "destination": "/api/case-study?slug=:slug" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/start", "destination": "/start/index.html" },
    { "source": "/start/welcome", "destination": "/start/welcome/index.html" }
  ],
  "headers": [
    {
      "source": "/customers/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/legal/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/legal(/.*)?",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/customers(/.*)?",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/api/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/start(/.*)?",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/(checkout|stripe-webhook)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/race(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
